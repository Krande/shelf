SHELF_DATABASE_URL=postgresql+asyncpg://shelf:shelf@localhost:5432/shelf
SHELF_REDIS_URL=redis://localhost:6379/0

# These match the dev object store compose.yaml starts (either the garage or
# the rustfs profile — both listen on :3900 with the same credentials).
# `pixi run up` sets them for the backend it launches, so you only need them
# here if you run `pixi run dev-api` by hand. Throwaway values; don't reuse.
SHELF_S3_ENDPOINT=http://localhost:3900
# Only needed when the browser cannot reach SHELF_S3_ENDPOINT (the API and the
# browser are on different networks). Presigned URLs are signed for this host
# instead. Unset in dev, where both sides share localhost.
# SHELF_S3_ENDPOINT_PUBLIC=
SHELF_S3_REGION=us-east-1
SHELF_S3_BUCKET=shelf
SHELF_S3_ACCESS_KEY_ID=SHELFDEVACCESSKEY
SHELF_S3_SECRET_ACCESS_KEY=shelfdevsecretkey

SHELF_GOTENBERG_URL=http://localhost:3000

SHELF_CORS_ORIGINS=["http://localhost:5173"]

# Emails promoted to the admin role on login. Promote-only, so roles you
# change in the UI stick and editing this list never strips anyone. A fresh
# instance has no admin at all — set this once to get the first one.
# `pixi run grant-admin <email>` does the same without a restart.
SHELF_ADMIN_EMAILS=[]
