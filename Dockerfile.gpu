# GPU worker image — runs the olmOCR (Qwen2.5-VL-7B) consumer and,
# eventually, the Marker outline consumer. Built separately from the
# CPU image (see top-level Dockerfile) so the API + CPU worker stay
# small (no PyTorch, no model weights).
#
# Deploy this on the host with the GPU. Either pull the image
# straight from your registry (CI builds + pushes alongside the CPU
# image) or `pixi run gpu-image-build` to build locally; then `pixi
# run gpu-run` starts a long-running container with --gpus all and
# --restart unless-stopped. See pixi.toml's GPU tasks for the full
# flow plus .env.gpu.example for the cluster URLs the worker needs.
#
# The GPU pod consumes the same JetStream stream the CPU worker
# subscribes to; different durables and subjects, no overlap.
#
# Packages come from pixi.lock's `gpu` environment, like every other image
# here — see the header of pixi.toml for why that is not negotiable. The
# CUDA wheels are the one thing in this project fetched from an index other
# than conda-forge, because no conda-forge build carries cu124.

# ── Stage 1: install the locked gpu environment ───────────────────────────────
FROM ghcr.io/prefix-dev/pixi:0.78.0-bookworm AS build

WORKDIR /app
COPY pixi.toml pixi.lock ./
COPY backend ./backend
# `--locked` validates the whole manifest, so the other path dependencies have
# to be readable even though the gpu environment installs neither.
COPY migrate ./migrate
COPY cli ./cli
RUN pixi install --locked --environment gpu

# ── Stage 2: runtime on the CUDA base ────────────────────────────────────────
#
# 12.6.3 is the latest stable tag in the cu12 series long-lived on
# Docker Hub — 12.4.0 was already retired. Pascal (sm_60/sm_61) is
# still supported in 12.x; only Maxwell sm_50/sm_52 was dropped on
# the way to CUDA 13. cu124 PyTorch wheels run forward-compatibly
# on a 12.6 runtime.
FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    HF_HOME=/app/.cache/huggingface

# The only apt left, and not dependency management: ca-certificates for the
# base image's own TLS trust, and libgomp for the OpenMP runtime the CUDA
# wheels expect from the system rather than bundling. Python, poppler,
# tesseract, ghostscript and the rest arrive in the locked environment below.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Copied to the same absolute path it was built at: a conda environment has
# that prefix compiled into its scripts and libraries.
COPY --from=build /app/.pixi/envs/gpu /app/.pixi/envs/gpu
COPY --from=build /app/backend /app/backend

# Activation by ENV, not by an entrypoint script: this image's command is
# overridden at the deployment level (pixi.toml's `gpu-run` task, and the chart
# for in-cluster pods), and a wrapper would not run for those.
ENV PATH=/app/.pixi/envs/gpu/bin:$PATH
# Normally set by conda-forge's tesseract activation hook, which nothing
# activates here.
ENV TESSDATA_PREFIX=/app/.pixi/envs/gpu/share/tessdata

WORKDIR /app/backend

# Image tag is stamped at build time so the worker can surface "I am
# running sha-XXXXX" in the same way the CPU image does.
ARG DOCKER_IMAGE_TAG=dev
ENV SHELF_IMAGE_TAG=${DOCKER_IMAGE_TAG}

# The HF cache lives at /app/.cache/huggingface — mount a PVC there
# so the model weights (~14 GB unquantised, ~7 GB FP8) don't get
# re-downloaded on every pod restart.
RUN mkdir -p ${HF_HOME} \
    # Ubuntu 24.04 ships with a default `ubuntu` account at UID 1000;
    # evict it before claiming the same UID for our service user.
    # `|| true` so we don't error on minimal bases that don't have it.
    && userdel -r ubuntu 2>/dev/null || true \
    && useradd -r -u 1000 shelf \
    && chown -R 1000:1000 /app
USER 1000

# Fail the build rather than a GPU pod: the worker imports, torch is the cu124
# build, and the binaries olmOCR shells out to are on PATH. torch.cuda is not
# checked — there is no GPU in a build container.
RUN python -c "import shelf.worker, torch, sys; sys.exit(0 if torch.version.cuda.startswith('12') else 1)" \
 && pdftoppm -v \
 && tesseract --list-langs 2>&1 | grep -qx eng

# The worker process. SHELF_WORKER_CONSUMERS picks which JetStream
# subject(s) this pod consumes; default to ocr-gpu so the GPU image
# does GPU work by default. Override at the deployment level if a
# host should also pick up CPU jobs.
ENV SHELF_WORKER_CONSUMERS=ocr-gpu

CMD ["python", "-m", "shelf.worker"]
